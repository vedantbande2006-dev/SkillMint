generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  DRAFT
  OPEN
  ASSIGNED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum ApplicationStatus { PENDING ACCEPTED REJECTED WITHDRAWN }
enum SubmissionStatus { SUBMITTED REVISION_REQUESTED APPROVED REJECTED }
enum PaymentStatus { CREATED AWAITING_SIGNATURE SUBMITTED PENDING CONFIRMED FAILED RECONCILIATION_REQUIRED RELEASED REFUNDED }

model User {
  id          String   @id @default(cuid())
  wallet      String   @unique
  displayName String?
  bio         String?  @db.VarChar(500)
  skills      String[] @default([])
  portfolio   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientTasks Task[]   @relation("ClientTasks")
  assignments Task[]   @relation("AssignedWorker")
  applications Application[]
  submissions Submission[]
  reviewsGiven Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  sessions    Session[]
}

model Task {
  id          String     @id @default(cuid())
  publicId    String     @unique
  clientId    String
  client      User       @relation("ClientTasks", fields: [clientId], references: [id])
  workerId    String?
  worker      User?      @relation("AssignedWorker", fields: [workerId], references: [id])
  title       String     @db.VarChar(120)
  description String     @db.VarChar(10000)
  category    String     @db.VarChar(60)
  skills      String[]   @default([])
  budgetBaseUnits String
  tokenAddress String?
  deadline    DateTime?
  status      TaskStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  applications Application[]
  submissions Submission[]
  payment     Payment?
  reviews     Review[]
  @@index([status, createdAt])
  @@index([clientId, status])
}

model Application {
  id        String @id @default(cuid())
  taskId    String
  task      Task @relation(fields: [taskId], references: [id])
  workerId  String
  worker    User @relation(fields: [workerId], references: [id])
  message   String @db.VarChar(2000)
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  @@unique([taskId, workerId])
}

model Submission {
  id          String @id @default(cuid())
  taskId      String
  task        Task @relation(fields: [taskId], references: [id])
  workerId    String
  worker      User @relation(fields: [workerId], references: [id])
  note        String @db.VarChar(3000)
  privateObjectKey String?
  externalUrl String?
  status      SubmissionStatus @default(SUBMITTED)
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  @@index([taskId, createdAt])
}

model Payment {
  id              String @id @default(cuid())
  taskId          String @unique
  task            Task @relation(fields: [taskId], references: [id])
  amountBaseUnits String
  tokenAddress    String
  chainId         Int
  escrowAddress   String?
  status          PaymentStatus @default(CREATED)
  fundingTxHash   String?
  releaseTxHash   String?
  refundTxHash    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SessionNonce {
  id        String   @id @default(cuid())
  wallet    String
  nonce     String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([wallet, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model Review {
  id          String @id @default(cuid())
  taskId      String
  task        Task @relation(fields: [taskId], references: [id])
  reviewerId  String
  reviewer    User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  recipientId String
  recipient   User @relation("ReviewsReceived", fields: [recipientId], references: [id])
  rating      Int
  comment     String? @db.VarChar(1000)
  createdAt   DateTime @default(now())
  @@unique([taskId, reviewerId])
}
